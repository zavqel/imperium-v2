{
  "name": "imperium-v2",
  "version": "0.1.0",
  "private": true,
  "description": "IMPÉRIUM Lava Jato e Estacionamento — plataforma V2",
  "scripts": {
    "check:worker": "node --check apps/api/src/index.js && node --check apps/api/src/availability-coordinator.js",
    "dev:api": "wrangler dev",
    "deploy:api": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply imperium-v2-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply imperium-v2-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
