{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imperium-v2-api",
  "main": "apps/api/src/index.js",
  "compatibility_date": "2026-11-07",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 0.1 },
    "redact_query_string": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imperium-v2-db",
      "database_id": "be92f376-dc38-4a33-a3a6-5edb1454e6ef",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "imperium-v2-media" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AVAILABILITY", "class_name": "AvailabilityCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AvailabilityCoordinator"] }
  ],
  "triggers": { "crons": ["*/1 * * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "",
    "APP_TIME_ZONE": "America/Sao_Paulo",
    "HOLD_DURATION_MINUTES": "10"
  }
}
